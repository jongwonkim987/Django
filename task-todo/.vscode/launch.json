{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Run Server (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "--noreload"],
      "django": true,
      "justMyCode": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings"
      }
    }
  ]
}
